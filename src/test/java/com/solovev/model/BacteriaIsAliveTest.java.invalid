package com.solovev.model;import org.junit.jupiter.api.Assertions;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import java.util.Objects;
import java.util.Random;
import java.util.function.Supplier;

public class BacteriaIsAliveTest {
    @Test
    @DisplayName("Test to check if the bacteria is alive")
    public void testIfBacteriaIsAlive() {
        // Arrange
        Bacteria bacteria = new Bacteria();
        // Act
        boolean result = bacteria.isAlive();
        // Assert
        Assertions.assertTrue(result, "Bacteria is expected to be alive after creation");
    }
    @Test
    @DisplayName("Test to check the isAlive method after setting the bacteria to dead")
    public void testIsAliveAfterSettingBacteriaToDead() {
        // Arrange
        Bacteria bacteria = new Bacteria();
        bacteria.setDead();
        // Act
        boolean result = bacteria.isAlive();
        // Assert
        Assertions.assertFalse(result, "Bacteria is expected to be dead after calling setDead()");
    }
}