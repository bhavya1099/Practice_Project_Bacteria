@RunWith(JUnit4.class)
public class PetriDishGetBacteriaTest {
    @Test
    @Category(Categories.valid.class)
    public void testGetBacteriaWithValidAddress() {
        // Arrange
        Map<Address, Bacteria> addresses = new HashMap<>();
        Address address = new Address(5, 5);
        Bacteria bacteria = new Bacteria();
        addresses.put(address, bacteria);
        PetriDish petriDish = new PetriDish();
        // Using reflection to set private field
        Field field = PetriDish.class.getDeclaredField("addresses");
        field.setAccessible(true);
        field.set(petriDish, addresses);
        // Act
        Bacteria result = petriDish.getBacteria(5, 5);
        // Assert
        assertEquals(bacteria, result);
    }
    @Test
    @Category(Categories.valid.class)
    public void testGetBacteriaWithEmptyAddress() {
        // Arrange
        Map<Address, Bacteria> addresses = new HashMap<>();
        PetriDish petriDish = new PetriDish();
        // Using reflection to set private field
        Field field = PetriDish.class.getDeclaredField("addresses");
        field.setAccessible(true);
        field.set(petriDish, addresses);
        // Act
        Bacteria result = petriDish.getBacteria(5, 5);
        // Assert
        assertNull(result);
    }
    @Test
    @Category(Categories.invalid.class)
