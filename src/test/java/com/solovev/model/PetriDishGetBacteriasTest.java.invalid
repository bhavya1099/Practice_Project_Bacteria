package com.solovev.model;import org.junit.Before;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import java.util.*;
import static org.junit.Assert.*;
import java.util.function.Supplier;
import java.util.stream.Collectors;

public class PetriDishGetBacteriasTest {
    private PetriDish petriDish;
    private Map<Address, Bacteria> bacterias;
    @Before
    public void setUp() {
        petriDish = new PetriDish();
        bacterias = new HashMap<>();
        bacterias.put(new Address(1, 1), new Bacteria(new ConfigurationOfBacteriaBehavior(0, 0, 0, 0)));
        bacterias.put(new Address(2, 2), new Bacteria(new ConfigurationOfBacteriaBehavior(0, 0, 0, 0)));
        petriDish.setBacterias(bacterias);
    }
    @Test(expected = UnsupportedOperationException.class)
    @Category(Categories.valid.class)
    public void testGetBacteriasReturnsUnmodifiableMap() {
        Map<Address, Bacteria> returnedBacterias = petriDish.getBacterias();
        returnedBacterias.put(new Address(3, 3), new Bacteria(new ConfigurationOfBacteriaBehavior(0, 0, 0, 0)));
    }
    @Test
    @Category(Categories.valid.class)
    public void testGetBacteriasReturnsCorrectData() {
        Map<Address, Bacteria> returnedBacterias = petriDish.getBacterias();
        assertEquals(bacterias, returnedBacterias);
    }
    @Test
    @Category(Categories.valid.class)
    public void testGetBacteriasReturnsMapWithCorrectSize() {
        Map<Address, Bacteria> returnedBacterias = petriDish.getBacterias();
        assertEquals(bacterias.size(), returnedBacterias.size());
    }
    @Test
    @Category(Categories.valid.class)
    public void testGetBacteriasReturnsMapWithCorrectKeys() {
        Map<Address, Bacteria> returnedBacterias = petriDish.getBacterias();
        assertEquals(bacterias.keySet(), returnedBacterias.keySet());
    }
}