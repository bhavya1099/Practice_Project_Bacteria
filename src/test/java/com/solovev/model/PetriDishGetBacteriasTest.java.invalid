package com.solovev.model;import org.junit.*;
import org.junit.experimental.categories.Category;
import org.junit.rules.ExpectedException;
import java.util.*;
import java.util.function.Supplier;
import java.util.stream.Collectors;
import com.solovev.model.Address;
import com.solovev.model.Bacteria;

// Import the Address and Bacteria classes
public class PetriDishGetBacteriasTest {
  
    @Rule
    public ExpectedException exception = ExpectedException.none();
  
    @Test
    @Category(Categories.valid.class)
    public void testGetBacteriasReturnsUnmodifiableMap() {
        PetriDish petriDish = new PetriDish();
        Address address = new Address(1, 1);
        Bacteria bacteria = new Bacteria();
        petriDish.addBacteria(address, bacteria); // Use the addBacteria method
        Map<Address, Bacteria> bacteriaMap = petriDish.getBacterias();
        exception.expect(UnsupportedOperationException.class);
        bacteriaMap.put(new Address(2, 2), new Bacteria());
    }
    @Test
    @Category(Categories.valid.class)
    public void testGetBacteriasReturnsAllBacteria() {
        PetriDish petriDish = new PetriDish();
        Address address1 = new Address(1, 1);
        Bacteria bacteria1 = new Bacteria();
        petriDish.addBacteria(address1, bacteria1); // Use the addBacteria method
        Address address2 = new Address(2, 2);
        Bacteria bacteria2 = new Bacteria();
        petriDish.addBacteria(address2, bacteria2); // Use the addBacteria method
        Map<Address, Bacteria> bacteriaMap = petriDish.getBacterias();
        Assert.assertEquals(2, bacteriaMap.size());
        Assert.assertTrue(bacteriaMap.containsKey(address1));
        Assert.assertTrue(bacteriaMap.containsKey(address2));
        Assert.assertTrue(bacteriaMap.containsValue(bacteria1));
        Assert.assertTrue(bacteriaMap.containsValue(bacteria2));
    }
    @Test
    @Category(Categories.boundary.class)
    public void testGetBacteriasReturnsEmptyMapForEmptyPetriDish() {
        PetriDish petriDish = new PetriDish();
        Map<Address, Bacteria> bacteriaMap = petriDish.getBacterias();
        Assert.assertTrue(bacteriaMap.isEmpty());
    }
}