package com.solovev.model;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import static org.junit.Assert.assertEquals;
import java.util.*;
import java.util.function.Supplier;
import java.util.stream.Collectors;

public class PetriDishCalculateDaysTest {
    @Test
    @Category(Categories.invalid.class)
    public void testCalculateDaysWithZeroConfiguration() {
        PetriDish petriDish = new PetriDish();
        ConfigurationOfBacteriaBehavior conf = new ConfigurationOfBacteriaBehavior(0, 0, 0, 0);
        Response response = petriDish.calculateDays(conf);
        assertEquals(-1, response.getDays());
    }
    @Test
    @Category(Categories.valid.class)
    public void testCalculateDaysWithNonZeroConfiguration() {
        PetriDish petriDish = new PetriDish();
        ConfigurationOfBacteriaBehavior conf = new ConfigurationOfBacteriaBehavior(1, 1, 1, 1);
        Response response = petriDish.calculateDays(conf);
        assertEquals(true, response.getDays() > 0);
    }
    @Test
    @Category(Categories.boundary.class)
    public void testCalculateDaysWhenPetriDishIsAlreadyFull() {
        PetriDish petriDish = new PetriDish();
        ConfigurationOfBacteriaBehavior conf = new ConfigurationOfBacteriaBehavior(1, 1, 1, 1);
        // Fill the PetriDish
        for (int i = 0; i < PetriDish.MAX_SIZE; i++) {
            for (int j = 0; j < PetriDish.MAX_SIZE; j++) {
                petriDish.putBacteria(new Address(i, j), new Bacteria(conf));
            }
        }
        Response response = petriDish.calculateDays(conf);
        assertEquals(0, response.getDays());
    }
    @Test
    @Category(Categories.integration.class)
    public void testCalculateDaysWithConfigurationLeadingToBacteriaDeath() {
        PetriDish petriDish = new PetriDish();
        ConfigurationOfBacteriaBehavior conf = new ConfigurationOfBacteriaBehavior(1, 1, 1, 1);
        Response response = petriDish.calculateDays(conf);
        assertEquals(true, response.getDeadBacteria() > 0);
    }
}