package com.solovev.model;
import org.junit.Before;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.junit.runners.JUnit4;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import static org.junit.Assert.assertEquals;
import static org.mockito.Mockito.*;
import org.junit.experimental.categories.Category;
import java.util.*;
import java.util.function.Supplier;
import java.util.stream.Collectors;

@RunWith(JUnit4.class)
public class PetriDishCalculateDaysTest {
    @Mock
    private PetriDish petriDish;
    @Before
    public void setUp() {
        MockitoAnnotations.initMocks(this);
    }
    @Test
    @Category(Categories.invalid.class)
    public void testCalculateDaysWithZeroConfiguration() {
        ConfigurationOfBacteriaBehavior conf = mock(ConfigurationOfBacteriaBehavior.class);
        when(conf.toNumber()).thenReturn(0);
        Response response = new Response(-1, 0);
        when(petriDish.calculateDays(conf)).thenReturn(response);
        Response actualResponse = petriDish.calculateDays(conf);
        assertEquals(response.getDays(), actualResponse.getDays());
        assertEquals(response.getDeadBacteria(), actualResponse.getDeadBacteria());
    }
    @Test
    @Category(Categories.valid.class)
    public void testCalculateDaysWithNonZeroConfigurationAndNotFullDish() {
        ConfigurationOfBacteriaBehavior conf = mock(ConfigurationOfBacteriaBehavior.class);
        when(conf.toNumber()).thenReturn(5);
        when(petriDish.notFull()).thenReturn(true);
        Response response = new Response(5, 0);
        when(petriDish.calculateDays(conf)).thenReturn(response);
        Response actualResponse = petriDish.calculateDays(conf);
        assertEquals(response.getDays(), actualResponse.getDays());
        assertEquals(response.getDeadBacteria(), actualResponse.getDeadBacteria());
    }
    @Test
    @Category(Categories.boundary.class)
    public void testCalculateDaysWithNonZeroConfigurationAndFullDish() {
        ConfigurationOfBacteriaBehavior conf = mock(ConfigurationOfBacteriaBehavior.class);
        when(conf.toNumber()).thenReturn(5);
        when(petriDish.notFull()).thenReturn(false);
        Response response = new Response(0, 0);
        when(petriDish.calculateDays(conf)).thenReturn(response);
        Response actualResponse = petriDish.calculateDays(conf);
        assertEquals(response.getDays(), actualResponse.getDays());
        assertEquals(response.getDeadBacteria(), actualResponse.getDeadBacteria());
    }
}