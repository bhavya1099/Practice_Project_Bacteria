package com.solovev.model;import org.junit.Before;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import static org.junit.Assert.*;
import java.util.*;
import java.util.function.Supplier;
import java.util.stream.Collectors;

public class PetriDishNotFullTest {
    
    private PetriDish petriDish;
    
    @Before
    public void setUp() {
        petriDish = new PetriDish();
    }
    @Test
    @Category(Categories.valid.class)
    public void testNotFullDish() {
        petriDish.size = 10;
        petriDish.fill = 50;
        assertTrue(petriDish.notFull());
    }
    @Test
    @Category(Categories.boundary.class)
    public void testFullDish() {
        petriDish.size = 10;
        petriDish.fill = 100;
        assertFalse(petriDish.notFull());
    }
    @Test
    @Category(Categories.invalid.class)
    public void testOverfilledDish() {
        petriDish.size = 10;
        petriDish.fill = 101;
        assertFalse(petriDish.notFull());
    }
}